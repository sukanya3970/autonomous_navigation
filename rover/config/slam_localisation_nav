slam_toolbox:
  ros__parameters:
    solver_plugin: solver_plugins::CeresSolver
    ceres_linear_solver: SPARSE_NORMAL_CHOLESKY
    ceres_preconditioner: SCHUR_JACOBI
    ceres_trust_strategy: LEVENBERG_MARQUARDT
    num_threads: 4
    odom_frame: odom
    map_frame: map
    base_frame: base_link
    scan_topic: /scan

    # Localization, not mapping.
    mode: localization

    # Pose-graph file is supplied by nav_launch.py through map_file_name.
    use_map_saver: false

    debug_logging: false
    throttle_scans: 1

    transform_publish_period: 0.05
    map_update_interval: 2.0

    resolution: 0.05
    restamp_tf: true

    min_laser_range: 0.05
    max_laser_range: 10.0

    minimum_time_interval: 0.05
    transform_timeout: 1.0
    tf_buffer_duration: 30.0
    minimum_travel_distance: 0.05
    minimum_travel_heading: 0.05
    scan_buffer_size: 5
    scan_buffer_maximum_scan_distance: 5.0

    link_match_minimum_response_fine: 0.15
    link_scan_maximum_distance: 2.0

    # Do not use wheel/IMU odometry as a second SLAM input here.
    # The custom EKF provides odom -> base_link.
    use_scan_matching: true
    use_scan_barycenter: true
    coarse_search_angle_offset: 0.524
    coarse_angle_resolution: 0.0349
    check_min_dist_and_heading_precisely: true
   
    correlation_search_space_dimension: 0.5
    correlation_search_space_resolution: 0.01
    correlation_search_space_smear_deviation: 0.1

    fine_search_angle_offset: 0.00349
