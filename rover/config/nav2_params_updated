# ============================================================================
# BT NAVIGATOR
# ============================================================================

bt_navigator:
  ros__parameters:
    use_sim_time: false

    global_frame: map
    robot_base_frame: base_link
    odom_topic: /odometry/filtered

    transform_tolerance: 0.5
    default_server_timeout: 200

    # Uses default Nav2 behavior trees automatically.

    navigators:
      - "navigate_to_pose"
      - "navigate_through_poses"

    navigate_to_pose:
      plugin: "nav2_bt_navigator::NavigateToPoseNavigator"

    navigate_through_poses:
      plugin: "nav2_bt_navigator::NavigateThroughPosesNavigator"

    error_code_names:
      - compute_path_error_code
      - follow_path_error_code


# ============================================================================
# CONTROLLER SERVER
# ============================================================================

controller_server:
  ros__parameters:
    use_sim_time: false
    
    controller_frequency: 10.0
    costmap_update_timeout: 0.20

    min_x_velocity_threshold: 0.001
    min_y_velocity_threshold: 0.001
    min_theta_velocity_threshold: 0.01

    failure_tolerance: 0.3

    progress_checker_plugins:
      - "progress_checker"

    goal_checker_plugins:
      - "goal_checker"

    controller_plugins:
      - "FollowPath"


    # ------------------------------------------------------------------------
    # PROGRESS CHECKER
    # ------------------------------------------------------------------------

    progress_checker:
      plugin: "nav2_controller::PoseProgressChecker"
      required_movement_radius: 0.01
      required_movement_angle: 0.1
      movement_time_allowance: 15.0


    # ------------------------------------------------------------------------
    # GOAL CHECKER
    # ------------------------------------------------------------------------

    goal_checker:
      plugin: "nav2_controller::SimpleGoalChecker"
      xy_goal_tolerance: 0.15
      yaw_goal_tolerance: 0.05
      stateful: true


    # ------------------------------------------------------------------------
    # REGULATED PURE PURSUIT
    # ------------------------------------------------------------------------

    FollowPath:
      plugin: "nav2_regulated_pure_pursuit_controller::RegulatedPurePursuitController"

      desired_linear_vel: 0.30
      lookahead_dist: 0.95
      min_lookahead_dist: 0.20
      max_lookahead_dist: 1.10
      lookahead_time: 1.0
      use_velocity_scaled_lookahead_dist: true
      transform_tolerance: 0.5

      min_approach_linear_velocity: 0.02
      approach_velocity_scaling_dist: 1.0

      use_collision_detection: true
      max_allowed_time_to_collision_up_to_carrot: 1.0

      use_regulated_linear_velocity_scaling: true
      regulated_linear_scaling_min_radius: 1.0
      regulated_linear_scaling_min_speed: 0.3

      use_cost_regulated_linear_velocity_scaling: true
      cost_scaling_dist: 1.0
      cost_scaling_gain: 0.8

      use_fixed_curvature_lookahead: true
      curvature_lookahead_dist: 1.0

      use_rotate_to_heading: true
      rotate_to_heading_angular_vel: 2.0
      rotate_to_heading_min_angle: 0.5
      max_angular_accel: 1.0

      allow_reversing: false
      max_robot_pose_search_dist: 3.0
      stateful: true


# ============================================================================
# PLANNER SERVER
# ============================================================================

planner_server:
  ros__parameters:
    use_sim_time: false
    expected_planner_frequency: 10.0
    planner_plugins:
      - "GridBased"

    costmap_update_timeout: 1.0

    GridBased:
      plugin: "nav2_navfn_planner::NavfnPlanner"
      tolerance: 0.01
      use_astar: false
      allow_unknown: true


# ============================================================================
# SMOOTHER SERVER
# ============================================================================

smoother_server:
  ros__parameters:
    use_sim_time: false
    smoother_plugins:
      - "simple_smoother"

    simple_smoother:
      plugin: "nav2_smoother::SimpleSmoother"
      tolerance: 1.0e-10
      max_its: 1000
      do_refinement: true


# ============================================================================
# BEHAVIOR SERVER
# ============================================================================

behavior_server:
  ros__parameters:
    use_sim_time: false

    local_costmap_topic: local_costmap/costmap_raw
    global_costmap_topic: global_costmap/costmap_raw
    local_footprint_topic: local_costmap/published_footprint
    global_footprint_topic: global_costmap/published_footprint

    local_frame: odom
    global_frame: map
    robot_base_frame: base_link

    transform_tolerance: 0.5
    cycle_frequency: 10.0
    simulate_ahead_time: 1.5

    max_rotational_vel: 3.0
    min_rotational_vel: 2.0
    rotational_acc_lim: 2.0

    behavior_plugins:
      - "spin"
      - "backup"
      - "drive_on_heading"
      - "wait"

    spin:
      plugin: "nav2_behaviors::Spin"

    backup:
      plugin: "nav2_behaviors::BackUp"

    drive_on_heading:
      plugin: "nav2_behaviors::DriveOnHeading"

    wait:
      plugin: "nav2_behaviors::Wait"


# ============================================================================
# LOCAL COSTMAP
# ============================================================================

local_costmap:
  local_costmap:
    ros__parameters:
      use_sim_time: false

      update_frequency: 10.0
      publish_frequency: 10.0

      global_frame: odom
      robot_base_frame: base_link
      rolling_window: true

      width: 5
      height: 5
      resolution: 0.05
      transform_tolerance: 0.7
      robot_radius: 0.30
      always_send_full_costmap: true

      plugins:
        - "obstacle_layer"
        - "inflation_layer"

      obstacle_layer:
        plugin: "nav2_costmap_2d::ObstacleLayer"
        enabled: true
        min_obstacle_height: 0.05
        max_obstacle_height: 2.0
        observation_sources: scan
        scan:
          topic: /scan
          data_type: LaserScan
          clearing: true
          marking: true
          obstacle_max_range: 10.0
          raytrace_max_range: 10.0
          obstacle_min_range: 0.02
          raytrace_min_range: 0.02
          min_obstacle_height: 0.05     # <--- ADD THIS
          max_obstacle_height: 2.00
          expected_update_rate: 0.5      # <--- ADD THIS
      inflation_layer:
        plugin: "nav2_costmap_2d::InflationLayer"
        cost_scaling_factor: 3.5
        inflation_radius: 0.35


# ============================================================================
# GLOBAL COSTMAP
# ============================================================================

global_costmap:
  global_costmap:
    ros__parameters:
      use_sim_time: false

      update_frequency: 5.0
      publish_frequency: 5.0

      global_frame: map
      robot_base_frame: base_link
      resolution: 0.05
      transform_tolerance: 0.7
      robot_radius: 0.30
      track_unknown_space: true
      always_send_full_costmap: true

      plugins:
        - "static_layer"
        - "obstacle_layer"
        - "inflation_layer"

      static_layer:
        plugin: "nav2_costmap_2d::StaticLayer"
        map_subscribe_transient_local: true

      obstacle_layer:
        plugin: "nav2_costmap_2d::ObstacleLayer"
        enabled: true
        observation_sources: scan
        scan:
          topic: /scan
          data_type: LaserScan
          clearing: true
          marking: true
          obstacle_max_range: 10.0
          raytrace_max_range: 10.0
          obstacle_min_range: 0.05
          raytrace_min_range: 0.05
          min_obstacle_height: 0.05     # <--- ADD THIS
          max_obstacle_height: 2.00      # <--- ADD THIS

      inflation_layer:
        plugin: "nav2_costmap_2d::InflationLayer"
        cost_scaling_factor: 3.0
        inflation_radius: 0.7


# ============================================================================
# VELOCITY SMOOTHER
# ============================================================================

velocity_smoother:
  ros__parameters:
    use_sim_time: false
    smoothing_frequency: 20.0
    scale_velocities: false
    feedback: "OPEN_LOOP"

    max_velocity: [0.3, 0.0, 2.0]
    min_velocity: [-0.3, 0.0, -2.0]
    max_accel: [0.1, 0.0, 2.0]
    max_decel: [-0.1, 0.0, -2.0]

    odom_topic: /odometry/filtered
    odom_duration: 0.10
    deadband_velocity: [0.0, 0.0, 0.0]
    velocity_timeout: 0.50
    enable_stamped_cmd_vel: false


# ============================================================================
# COLLISION MONITOR
# ============================================================================



collision_monitor:
  ros__parameters:
    use_sim_time: false

    base_frame_id: "base_link"
    odom_frame_id: "odom"

    cmd_vel_in_topic: "cmd_vel_smoothed"
    cmd_vel_out_topic: "cmd_vel"
    state_topic: "collision_monitor_state"

    transform_tolerance: 0.5
    source_timeout: 1.0
    base_shift_correction: true
    stop_pub_timeout: 2.0

    polygons: ["FootprintApproach"]

    FootprintApproach:
      type: "polygon"
      action_type: "approach"
      footprint_topic: "/local_costmap/published_footprint"
      time_before_collision: 1.2
      simulation_time_step: 0.1
      min_points: 6
      visualize: true
      enabled: true

    observation_sources: ["scan"]

    scan:
      type: "scan"
      topic: "/scan"
      enabled: true
      source_timeout: 1.0

# ============================================================================
# MAP SAVER
# ============================================================================

map_saver:
  ros__parameters:
    save_map_timeout: 5.0
    free_thresh_default: 0.25
    occupied_thresh_default: 0.65
    map_subscribe_transient_local: true
