// ============================================================================
// TELEMETRY
// ============================================================================
// Encoder values are ALREADY logically signed here.
// DO NOT apply encoder sign correction again in Python.

void sendTelemetry()
{
    static unsigned long lastTelemetry = 0;

    unsigned long now = millis();

    if (now - lastTelemetry < TELEMETRY_INTERVAL_MS)
        return;

    lastTelemetry = now;

    Serial.print("D,");
    Serial.print(now);

    Serial.print(",");
    // ONLY REAR ENCODER COUNTS ARE TELEMETRIED.
    Serial.print(readLREncoder());

    Serial.print(",");
    Serial.print(readRREncoder());

    Serial.print(",");
    Serial.print(imuYaw, 2);

    Serial.print(",");
    Serial.print(imuPitch, 2);

    Serial.print(",");
    Serial.print(imuRoll, 2);

    Serial.print(",");
    Serial.print(gyroX, 4);

    Serial.print(",");
    Serial.print(gyroY, 4);

    Serial.print(",");
    Serial.print(gyroZ, 4);

    Serial.print(",");
    Serial.print(accelX, 4);

    Serial.print(",");
    Serial.print(accelY, 4);

    Serial.print(",");
    Serial.println(accelZ, 4);
}


// ============================================================================
// COMMAND BUFFER
// ============================================================================

const uint8_t CMD_SIZE = 48;

char usbBuffer[CMD_SIZE];
char serial3Buffer[CMD_SIZE];

uint8_t usbIndex = 0;
uint8_t serial3Index = 0;

bool usbOverflow = false;
bool serial3Overflow = false;


// Strict float parse: whole token must be a valid number.
bool parseFloatStrict(const char *s, float &out)
{
    char *end = NULL;

    double d = strtod(s, &end);

    if (end == s || *end != '\0')
        return false;

    out = (float)d;

    return isfinite(out);
}


// ============================================================================
// PROCESS COMMAND
// ============================================================================
//
// Supported:
//     V <v> <w>
//     M RF LF LR RR      (raw PWM; RF/LF values accepted but ignored)
//     STOP | S
//     RESET
//     INFO
//     PING
//
// ============================================================================

void processCommand(char *cmd)
{
    // Remove leading spaces
    while (*cmd == ' ' || *cmd == '\t')
        cmd++;

    // Remove trailing whitespace
    int len = strlen(cmd);

    while (
        len > 0 &&
        (
            cmd[len - 1] == ' '  ||
            cmd[len - 1] == '\t' ||
            cmd[len - 1] == '\r' ||
            cmd[len - 1] == '\n'
        )
    )
    {
        cmd[len - 1] = '\0';
        len--;
    }

    if (*cmd == '\0')
        return;


    // STOP
    if (strcasecmp(cmd, "S") == 0 || strcasecmp(cmd, "STOP") == 0)
    {
        emergencyStop();
        return;
    }

    // RESET
    if (strcasecmp(cmd, "RESET") == 0)
    {
        resetSystem();
        return;
    }

    // INFO
    if (strcasecmp(cmd, "INFO") == 0)
    {
        sendInfoLine();
        return;
    }

    // PING
    if (strcasecmp(cmd, "PING") == 0)
    {
        Serial.println("PONG");
        return;
    }

    // MANUAL STOP
    if (manualStop)
    {
        Serial.println("MANUAL STOP ACTIVE");
        return;
    }


    // --------------------------------------------------------
    // CMD_VEL:  V <linear> <angular>
    // --------------------------------------------------------

    if (cmd[0] == 'V' || cmd[0] == 'v')
    {
        char *args = cmd + 1;

        while (*args == ' ' || *args == '\t')
            args++;

        char *vToken = strtok(args, " \t");
        char *wToken = strtok(NULL, " \t");

        if (vToken == NULL || wToken == NULL)
        {
            Serial.println("ERR V NEEDS 2 VALUES");
            return;
        }

        float v;
        float w;

        if (!parseFloatStrict(vToken, v) || !parseFloatStrict(wToken, w))
        {
            Serial.println("ERR V INVALID VALUES");
            return;
        }

        setCmdVel(v, w);

        return;
    }


    // --------------------------------------------------------
    // OLD M COMMAND:  M RF LF LR RR   (raw PWM)
    // --------------------------------------------------------

    if (cmd[0] == 'M' || cmd[0] == 'm')
    {
        int rf;
        int lf;
        int lr;
        int rr;

        int parsed = sscanf(cmd + 1, "%d %d %d %d", &rf, &lf, &lr, &rr);

        if (parsed != 4)
        {
            Serial.println("ERR M NEEDS 4 VALUES");
            return;
        }

        rf = constrain(rf, -MAX_PWM, MAX_PWM);
        lf = constrain(lf, -MAX_PWM, MAX_PWM);
        lr = constrain(lr, -MAX_PWM, MAX_PWM);
        rr = constrain(rr, -MAX_PWM, MAX_PWM);

        manualPWMMode = true;
        rotationMode = false;
        rotationBoostUntil = 0;

        // RF/LF values are accepted for protocol compatibility but ignored.
        // Front motors remain permanently braked.
        desiredPWM_RF = 0;
        desiredPWM_LF = 0;
        desiredPWM_LR = lr;
        desiredPWM_RR = rr;

        applyMotorOutputs();

        lastCmdTime = millis();

        return;
    }


    Serial.println("INVALID");
}


// ============================================================================
// SERIAL READER
// ============================================================================

void readPort(
    Stream &port,
    char *buffer,
    uint8_t &index,
    bool &overflow
)
{
    while (port.available())
    {
        char c = (char)port.read();

        // COMMAND END
        if (c == '\n' || c == '\r')
        {
            if (overflow)
            {
                // Discard the whole over-long line, including its tail.
                overflow = false;
                index = 0;

                Serial.println("ERR CMD TOO LONG");

                continue;
            }

            if (index > 0)
            {
                buffer[index] = '\0';

                processCommand(buffer);

                index = 0;
            }

            continue;
        }

        // PRINTABLE CHARACTER
        if (c >= 32 && c <= 126)
        {
            if (overflow)
                continue;

            if (index < CMD_SIZE - 1)
            {
                buffer[index++] = c;
            }
            else
            {
                overflow = true;
            }
        }
    }
}


// ============================================================================
// SETUP
// ============================================================================

void setup()
{
    Serial.begin(115200);
    Serial3.begin(9600);

    setupMotors();

    setupEncoders();
    resetEncoders();
    initializePIDMeasurement();

    Wire.begin();
    Wire.setClock(I2C_CLOCK_HZ);

    imuOK = bno.begin();

    if (imuOK)
    {
        delay(1000);

        bno.setExtCrystalUse(true);

        readIMU();

        lastIMUUpdate = millis();
    }

    lastCmdTime = millis();

    Serial.println(imuOK ? "BNO055 OK" : "BNO055 ERROR");

    sendInfoLine();

    Serial.println("READY");
}


// ============================================================================
// MAIN LOOP
// ============================================================================

void loop()
{
    // 1. RECEIVE COMMANDS
    readPort(Serial,  usbBuffer,     usbIndex,     usbOverflow);
    readPort(Serial3, serial3Buffer, serial3Index, serial3Overflow);

    unsigned long now = millis();


    // 2. IMU @ 20 Hz
    if (imuOK && (now - lastIMUUpdate) >= IMU_INTERVAL_MS)
    {
        lastIMUUpdate = now;

        readIMU();
    }


    // 3. WATCHDOG
    bool timedOut = (now - lastCmdTime) > CMD_TIMEOUT_MS;

    if (timedOut)
    {
        brakeAllMotors();

        manualPWMMode = false;
        rotationMode = false;
        rotationBoostUntil = 0;
        resetAllWheelPID();
        clearMeasuredVelocities();

        targetRF_RPM = 0;
        targetLF_RPM = 0;
        targetLR_RPM = 0;
        targetRR_RPM = 0;

        desiredPWM_RF = 0;
        desiredPWM_LF = 0;
        desiredPWM_LR = 0;
        desiredPWM_RR = 0;

        // PID timing/counts go stale while the loop is not running; force
        // re-initialisation so the next command doesn't see a huge dt.
        pidMeasurementInitialized = false;
    }


    // 4. CLOSED-LOOP WHEEL VELOCITY PID @ 20 Hz
    if (!timedOut)
    {
        updateWheelVelocityControl();
    }


    // 5. TELEMETRY @ 50 Hz
    sendTelemetry();
}
